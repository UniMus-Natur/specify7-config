<?xml version="1.0" encoding="UTF-8"?>
<viewset name="SystemSetup">
  <views>
    <view name="TypeSearchInfo" class="edu.ku.brc.af.ui.forms.validation.TypeSearchInfo" resourcelabels="false">
      <desc>The TypeSearchInfo Object form.</desc>
      <altviews>
        <altview name="TypeSearchInfo Edit" viewdef="TypeSearchInfo" mode="edit" validated="true" default="true" />
      </altviews>
    </view>
  </views>
  <viewdefs>
    <viewdef type="form" name="TypeSearchInfo" class="edu.ku.brc.af.ui.forms.validation.TypeSearchInfo" gettable="edu.ku.brc.af.ui.forms.DataGetterForObj" settable="edu.ku.brc.af.ui.forms.DataSetterForObj">
      <desc>The TypeSearchInfo Form</desc>
      <enableRules />
      <columnDef>p, 2px, p, p, p:g, f:250px:g</columnDef>
      <rowDef>p,2dlu,p,2dlu,p,2dlu,p,2dlu,p,2dlu,p,2dlu,p,2dlu,p,2dlu,f:p:g</rowDef>
      <rows>
        <row>
          <cell type="separator" label="Query Combobox Information" colspan="6" />
        </row>
        <row>
          <cell type="label" labelfor="tableCBX" label="Table" />
          <cell type="panel" id="tp" name="tp" coldef="p,f:p:g" rowdef="p" ignore="true" colspan="4">
            <rows>
              <row>
                <cell type="field" id="tableCBX" name="tableCBX" uitype="combobox" ignore="true" />
              </row>
            </rows>
          </cell>
        </row>
        <row>
          <cell type="label" labelfor="name" label="Name" />
          <cell type="field" id="name" name="name" uitype="text" isrequired="true" />
        </row>
        <row>
          <cell type="label" labelfor="displayColumns" label="Display Columns" />
          <cell type="field" id="displayColumns" name="displayColumns" uitype="textarea" isrequired="true" colspan="4" />
        </row>
        <row>
          <cell type="label" labelfor="searchFieldName" label="Search Field Name" />
          <cell type="field" id="searchFieldName" name="searchFieldName" uitype="text" isrequired="true" colspan="4" />
        </row>
        <row>
          <cell type="label" labelfor="format" label="Format" />
          <cell type="field" id="format" name="format" uitype="text" isrequired="true" />
        </row>
        <row>
          <cell type="label" labelfor="uiFieldFormatterNameCBX" label="UI Field Formatter" />
          <cell type="panel" id="uip" name="uip" coldef="p,f:p:g" rowdef="p" ignore="true" colspan="4">
            <rows>
              <row>
                <cell type="field" id="uiFieldFormatterNameCBX" name="uiFieldFormatterNameCBX" uitype="combobox" ignore="true" />
              </row>
            </rows>
          </cell>
        </row>
        <row>
          <cell type="label" labelfor="dataObjFormatterNameCBX" label="Data Obj Formatter" />
          <cell type="panel" id="dop" name="dop" coldef="p,f:p:g" rowdef="p" ignore="true" colspan="4">
            <rows>
              <row>
                <cell type="field" id="dataObjFormatterNameCBX" name="dataObjFormatterNameCBX" uitype="combobox" ignore="true" />
              </row>
            </rows>
          </cell>
        </row>
        <row>
          <cell type="label" labelfor="sqlTemplate" label="HQL Template" />
          <cell type="field" id="sqlTemplate" name="sqlTemplate" uitype="textarea" colspan="4" />
        </row>
      </rows>
    </viewdef>
  </viewdefs>
</viewset>
