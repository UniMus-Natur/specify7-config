<?xml version="1.0" encoding="UTF-8"?>
<viewset name="Global" i18nresname="global_views">
  <views>
    <view name="MailingAddress" class="java.util.Hashtable">
      <desc>The  gbif collection mailingaddress form.</desc>
      <altviews>
        <altview name="MailingAddress View" viewdef="MailingAddress" mode="view" validated="false" default="true" />
        <altview name="MailingAddress Edit" viewdef="MailingAddress" mode="edit" validated="false" />
      </altviews>
    </view>
  </views>
  <viewdefs>
    <viewdef type="form" name="MailingAddress" class="java.util.Hashtable" gettable="edu.ku.brc.af.ui.forms.DataGetterForHashMap" settable="edu.ku.brc.af.ui.forms.DataSetterForHashMap">
      <desc>the gbif collection mailing address form</desc>
      <enableRules />
      <columnDef>p,5dlu,p:g,5dlu,p</columnDef>
      <rowDef auto="true" cell="p" sep="2px" />
      <rows>
        <row>
          <cell type="label" label="Country" />
          <cell type="field" id="maCountry" name="country" uitype="text" colspan="3" />
        </row>
        <row>
          <cell type="label" label="Province" />
          <cell type="field" id="maProvince" name="province" uitype="text" colspan="3" />
        </row>
        <row>
          <cell type="label" label="City" />
          <cell type="field" id="maCity" name="city" uitype="text" colspan="3" />
        </row>
      </rows>
    </viewdef>
  </viewdefs>
</viewset>
