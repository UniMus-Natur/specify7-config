<?xml version="1.0" encoding="UTF-8"?>
<viewset name="SystemSetup">
  <views>
    <view name="ExcelExportInfo" class="java.util.Hashtable" resourcelabels="false">
      <altviews>
        <altview name="ExcelExportInfo Edit" viewdef="ExcelExportInfo" mode="edit" validated="true" />
      </altviews>
    </view>
  </views>
  <viewdefs>
    <viewdef type="form" name="ExcelExportInfo" class="java.util.Hashtable" gettable="edu.ku.brc.af.ui.forms.DataGetterForHashMap" settable="edu.ku.brc.af.ui.forms.DataSetterForHashMap">
      <desc>ExcelExportInfo Form</desc>
      <columnDef>p,3dlu,p:g</columnDef>
      <rowDef auto="true" cell="p" sep="2dlu" />
      <rows>
        <row>
          <cell type="label" labelfor="1" label="Title" />
          <cell type="field" id="1" name="Title" uitype="text" isrequired="true" />
        </row>
        <row>
          <cell type="label" labelfor="2" label="Filename" />
          <cell type="field" id="2" name="FilePath" uitype="browse" isrequired="true" cols="30" initialize="forinput=false;filefilterdesc=.xlsx files;filefilter=.xlsx;defaultExtension=xlsx" />
        </row>
      </rows>
    </viewdef>
  </viewdefs>
</viewset>
