<?xml version="1.0" encoding="UTF-8"?>
<viewset name="SystemSetup">
  <views>
    <view name="ChangePassword" class="java.util.Hashtable" resourcelabels="false">
      <altviews>
        <altview name="ChangePassword Edit" viewdef="ChangePassword" mode="edit" validated="true" />
      </altviews>
    </view>
  </views>
  <viewdefs>
    <viewdef type="form" name="ChangePassword" class="java.util.Hashtable" gettable="edu.ku.brc.af.ui.forms.DataGetterForHashMap" settable="edu.ku.brc.af.ui.forms.DataSetterForHashMap">
      <desc>ChangePassword Form</desc>
      <columnDef>p,3dlu,p:g</columnDef>
      <rowDef auto="true" cell="p" sep="2dlu" />
      <rows>
        <row>
          <cell type="label" labelfor="1" label="Old Password" />
          <cell type="field" id="1" name="OldPwd" uitype="password" isrequired="true" cols="20" />
        </row>
        <row>
          <cell type="label" labelfor="2" label="New Password" />
          <cell type="field" id="2" name="NewPwd1" uitype="password" isrequired="true" cols="20" />
        </row>
        <row>
          <cell type="label" labelfor="3" label="Verify New Password" />
          <cell type="field" id="3" name="NewPwd2" uitype="password" isrequired="true" cols="20" />
        </row>
        <row>
          <cell type="label" labelfor="4" label="Password Strength" />
          <!-- <cell type="field" id="4" name="strength" uitype="progress" isrequired="true" readonly="true"/> -->
          <cell type="field" id="4" uitype="plugin" name="this" initialize="name=PasswordStrengthUI" />
        </row>
      </rows>
    </viewdef>
  </viewdefs>
</viewset>
