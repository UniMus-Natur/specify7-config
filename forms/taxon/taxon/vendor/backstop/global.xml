      <desc>New Taxon Node Form</desc>
      <enableRules>
        <!--<rule id="acceptedParent"><![CDATA[!isAccepted.isSelected()]]></rule>-->
        <rule id="hybridParent1">isHybrid.isSelected()</rule>
        <rule id="hybridParent2">isHybrid.isSelected()</rule>
        <rule id="definitionItem">parent.getValue() != null</rule>
      </enableRules>
