              </row>
            </rows>
          </cell>
        </row>
        <row>
          <cell type="label" labelfor="1" />
          <cell type="field" id="1" uitype="text" name="guid" colspan="7" readonly="true" />
        </row>
        <row>
          <cell type="subview" viewname="TaxonSubform" id="acceptedChildren" name="acceptedChildren" colspan="10" />
        </row>
        <row>
