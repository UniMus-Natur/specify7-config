<?xml version="1.0" encoding="UTF-8"?>
<viewset name="NHM Mineralogi standard" i18nresname="views">
  <views>
    <view name="MineralAttributes" class="edu.ku.brc.specify.datamodel.CollectionObjectAttribute" resourcelabels="false" busrules="edu.ku.brc.specify.datamodel.busrules.CollectionObjectAttributeBusRules">
      <desc>Subform within the Collection Object form.</desc>
      <altviews>
        <altview name="MineralAttributes View" viewdef="MineralAttributes" mode="view" />
        <altview name="MineralAttributes Edit" viewdef="MineralAttributes" mode="edit" default="true" />
      </altviews>
    </view>
  </views>
  <viewdefs>
    <!-- 8. MINERAL ATTRIBUTES VIEWDEF -->
