      <desc>Mineral Attributes</desc>
      <columnDef>100px,2px,115px,5px,75px,2px,115px,5px,109px,2px,115px,5px,80px,2px,115px,0px,p:g</columnDef>
      <rowDef auto="true" sep="2px" cell="p" />
      <rows>
        <row>
          <cell type="label" label="Size/Dimensions:" labelfor="size" />
          <cell type="field" id="size" name="text3" uitype="text" />
          <cell type="label" label="Mass:" labelfor="mass" />
          <cell type="field" id="mass" name="text4" uitype="text" />
          <cell type="label" label="Analyses/XRD ID:" labelfor="analyses" />
          <cell type="field" id="analyses" name="text2" uitype="text" />
          <cell type="label" label="Purchase Price:" labelfor="purchasePrice" />
          <cell type="field" id="purchasePrice" name="number2" uitype="text" />
        </row>
        <row>
          <cell type="label" label="Price Raw:" labelfor="rawPrice" />
          <cell type="field" id="rawPrice" name="text1" uitype="text" colspan="3" />
        </row>
      </rows>
    </viewdef>
  </viewdefs>
</viewset>
