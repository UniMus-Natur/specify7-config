<?xml version="1.0" encoding="UTF-8"?>
<viewset name="NHM Mineralogi standard" i18nresname="views">
  <views>
    <view name="CollectingEvent" class="edu.ku.brc.specify.datamodel.CollectingEvent" isinternal="false" busrules="edu.ku.brc.specify.datamodel.busrules.CollectingEventBusRules" resourcelabels="false">
      <desc>CollectingEvent Form</desc>
      <altviews>
        <altview name="CollectingEvent View" viewdef="CollectingEvent" mode="view" default="true" />
        <altview name="CollectingEvent Edit" viewdef="CollectingEvent" mode="edit" />
      </altviews>
    </view>
  </views>
  <viewdefs>
    <!-- 3. COLLECTING EVENT FULL FORM -->
    <viewdef type="form" name="CollectingEvent" class="edu.ku.brc.specify.datamodel.CollectingEvent" gettable="edu.ku.brc.af.ui.forms.DataGetterForObj" settable="edu.ku.brc.af.ui.forms.DataSetterForObj">
      <desc>Collecting Event</desc>
      <columnDef>100px,2px,200px,5px,90px,2px,210px,5px,60px,2px,255px,0px,15px,p:g</columnDef>
      <rowDef auto="true" cell="p" sep="2px" />
      <rows>
        <row>
          <cell type="label" labelfor="7" />
          <cell type="field" id="7" name="startDate" uitype="formattedtext" uifieldformatter="Date" />
          <cell type="label" labelfor="8" />
          <cell type="field" id="8" name="endDate" uitype="formattedtext" uifieldformatter="Date" />
          <cell type="label" labelfor="13" />
          <cell type="field" id="13" name="verbatimDate" uitype="text" />
        </row>
        <row>
          <cell type="label" labelfor="4" />
          <cell type="field" id="4" name="locality" uitype="querycbx" initialize="name=Locality;title=Locality;clonebtn=true" colspan="9" />
        </row>
        <row>
          <cell type="label" labelfor="6" />
          <cell type="field" id="6" name="remarks" uitype="textareabrief" rows="2" colspan="9" />
        </row>
        <row>
          <cell type="subview" viewname="Collectors" id="12" name="collectors" colspan="12" rows="3" />
        </row>
      </rows>
    </viewdef>
  </viewdefs>
</viewset>
