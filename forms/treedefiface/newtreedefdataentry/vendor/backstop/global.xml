<?xml version="1.0" encoding="UTF-8"?>
<viewset name="Global" i18nresname="global_views">
  <views>
    <view name="TreeDefEditor" class="edu.ku.brc.specify.datamodel.TreeDefIface" busrules="edu.ku.brc.specify.datamodel.busrules.TreeDefBusRules" resourcelabels="false">
      <desc>New Tree Definition Data Entry Form</desc>
      <altviews>
        <altview name="NewTreeDefDataEntry" viewdef="NewTreeDefDataEntry" mode="edit" validated="true" />
      </altviews>
    </view>
  </views>
  <viewdefs>
    <viewdef type="form" name="NewTreeDefDataEntry" class="edu.ku.brc.specify.datamodel.TreeDefIface" gettable="edu.ku.brc.af.ui.forms.DataGetterForObj" settable="edu.ku.brc.af.ui.forms.DataSetterForObj">
      <desc>New Tree Definition Data Entry Form</desc>
      <columnDef>p,2px,p:g(2),p</columnDef>
      <rowDef auto="true" cell="p" sep="2px" />
      <rows>
        <row>
          <cell type="label" labelfor="1" label="Name" />
          <cell type="field" id="1" name="name" uitype="text" isrequired="true" />
        </row>
        <row>
          <cell type="label" labelfor="2" label="Full Name Direction" />
          <cell type="field" id="2" name="fullNameDirection" uitype="combobox" ignore="true" />
        </row>
        <row>
          <cell type="label" labelfor="3" label="Remarks" />
          <cell type="field" id="3" name="remarks" uitype="textareabrief" rows="2" />
        </row>
      </rows>
    </viewdef>
  </viewdefs>
</viewset>
