<?xml version="1.0" encoding="UTF-8"?>
<viewset name="NHM Mineralogi standard" i18nresname="views">
  <views>
    <view name="Preparation" class="edu.ku.brc.specify.datamodel.Preparation" busrules="edu.ku.brc.specify.datamodel.busrules.PreparationBusRules" resourcelabels="false">
      <desc>Preparation SubForm</desc>
      <altviews>
        <altview name="Preparation View" viewdef="Preparation" mode="view" />
        <altview name="Preparation Edit" viewdef="Preparation" mode="edit" default="true" />
        <altview name="Preparation Table View" viewdef="Preparation Table" mode="view" />
        <altview name="Preparation Table Edit" viewdef="Preparation Table" mode="edit" />
      </altviews>
    </view>
  </views>
  <viewdefs>
    <!-- 7. PREPARATION FORM & TABLE -->
    <viewdef type="formtable" name="Preparation Table" class="edu.ku.brc.specify.datamodel.Preparation" gettable="edu.ku.brc.af.ui.forms.DataGetterForObj" settable="edu.ku.brc.af.ui.forms.DataSetterForObj">
      <desc>Preparation subform table for Collection Object form.</desc>
      <definition>Preparation</definition>
    </viewdef>
    <viewdef type="form" name="Preparation" class="edu.ku.brc.specify.datamodel.Preparation" gettable="edu.ku.brc.af.ui.forms.DataGetterForObj" settable="edu.ku.brc.af.ui.forms.DataSetterForObj">
      <desc>Preparation subform for Collection Object form.</desc>
      <columnDef>100px,2px,130px,5px,90px,2px,110px,5px,100px,2px,160px,5px,100px,2px,160px,p:g</columnDef>
      <rowDef auto="true" cell="p" sep="2px" />
      <rows>
        <row>
          <cell type="label" labelfor="1" />
          <cell type="field" id="1" name="prepType" uitype="combobox" isrequired="true" />
          <cell type="label" labelfor="2" />
          <cell type="field" id="2" name="countAmt" uitype="text" />
          <cell type="label" label="Primary Storage:" labelfor="sLoc" />
          <cell type="field" id="sLoc" name="storageLocation" uitype="text" colspan="2" />
          <cell type="label" label="Temp Storage:" labelfor="sTemp" />
          <cell type="field" id="sTemp" name="text1" uitype="text" colspan="2" />
        </row>
        <row>
          <cell type="label" labelfor="rem" />
          <cell type="field" id="rem" name="remarks" uitype="textareabrief" rows="2" colspan="14" />
        </row>
      </rows>
    </viewdef>
  </viewdefs>
</viewset>
